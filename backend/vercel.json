{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/Velora/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ],
  "buildCommand": "cd Velora && python manage.py collectstatic --noinput"
}